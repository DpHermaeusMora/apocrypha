#!/bin/bash
# ssm-helper.sh

ssm_get() {
    local name="$1"
    local value
    local param_type
    
    # 파라미터 타입 확인
    param_type=$(aws ssm get-parameter --name "$name" --query "Parameter.Type" --output text 2>/dev/null)
    
    if [[ "$param_type" == "SecureString" ]]; then
        echo "[SECRET] $(aws ssm get-parameter --name "$name" --with-decryption --query "Parameter.Value" --output text)"
    else
        aws ssm get-parameter --name "$name" --with-decryption --query "Parameter.Value" --output text
    fi
}

ssm_set() {
    local name="$1"
    local value="$2"
    local is_secret=false
    local json_mode=false
    local entries=()
    
    # 첫 번째 인자가 -e로 시작하면 JSON 모드
    if [[ "$2" == "-e" ]] || [[ "$2" == "--entry" ]]; then
        json_mode=true
        shift 1  # name만 남기고 shift
    else
        shift 2  # name, value 둘 다 shift
    fi
    
    # 옵션 파싱
    while [[ $# -gt 0 ]]; do
        case $1 in
            -e|--entry)
                if [[ -z "$2" ]]; then
                    echo "Error: -e option requires key=value argument"
                    exit 1
                fi
                entries+=("$2")
                json_mode=true
                shift 2
                ;;
            -s|--secret)
                is_secret=true
                shift
                ;;
            *)
                echo "Unknown option: $1"
                exit 1
                ;;
        esac
    done
    
    if [[ "$json_mode" == "true" ]]; then
        # JSON 모드: -e 옵션들을 JSON으로 구성
        if [[ ${#entries[@]} -eq 0 ]]; then
            echo "Error: No entries provided. Use -e key=value"
            exit 1
        fi
        
        # 기존 파라미터 값 가져오기 (존재하는 경우)
        local existing_value
        existing_value=$(aws ssm get-parameter --name "$name" --with-decryption --query "Parameter.Value" --output text 2>/dev/null)
        
        local base_json="{}"
        if [[ -n "$existing_value" ]] && [[ "$existing_value" != "None" ]] && [[ "$existing_value" != "" ]]; then
            # 기존 값이 유효한 JSON인지 확인
            if echo "$existing_value" | jq . >/dev/null 2>&1; then
                base_json="$existing_value"
            else
                echo "Warning: Existing value is not valid JSON, starting with empty object"
            fi
        fi
        
        # 새로운 JSON 구성
        local new_json="$base_json"
        for entry in "${entries[@]}"; do
            if [[ "$entry" =~ ^([^=]+)=(.*)$ ]]; then
                local key="${BASH_REMATCH[1]}"
                local val="${BASH_REMATCH[2]}"
                
                # JSON 값으로 파싱 시도, 실패하면 문자열로 처리
                if echo "$val" | jq . >/dev/null 2>&1; then
                    new_json=$(echo "$new_json" | jq --arg k "$key" --argjson v "$val" '. + {($k): $v}')
                else
                    new_json=$(echo "$new_json" | jq --arg k "$key" --arg v "$val" '. + {($k): $v}')
                fi
            else
                echo "Error: Invalid entry format '$entry'. Use key=value"
                exit 1
            fi
        done
        
        value="$new_json"
    fi
    
    if [[ "$is_secret" == "true" ]]; then
        aws ssm put-parameter --name "$name" --value "$value" --type SecureString --overwrite
    else
        aws ssm put-parameter --name "$name" --value "$value" --type String --overwrite
    fi
}

ssm_del() {
    local name="$1"
    local delete_keys=()
    shift
    
    # 옵션 파싱
    while [[ $# -gt 0 ]]; do
        case $1 in
            -e|--entry)
                if [[ -z "$2" ]]; then
                    echo "Error: -e option requires key argument"
                    exit 1
                fi
                delete_keys+=("$2")
                shift 2
                ;;
            *)
                echo "Unknown option: $1"
                exit 1
                ;;
        esac
    done
    
    if [[ ${#delete_keys[@]} -gt 0 ]]; then
        # 부분 삭제: 지정된 키들만 JSON에서 제거
        local existing_value
        existing_value=$(aws ssm get-parameter --name "$name" --with-decryption --query "Parameter.Value" --output text 2>/dev/null)
        
        if [[ -z "$existing_value" ]] || [[ "$existing_value" == "None" ]]; then
            echo "Error: Parameter '$name' not found"
            exit 1
        fi
        
        # 기존 값이 유효한 JSON인지 확인
        if ! echo "$existing_value" | jq . >/dev/null 2>&1; then
            echo "Error: Existing value is not valid JSON"
            exit 1
        fi
        
        local new_json="$existing_value"
        for key in "${delete_keys[@]}"; do
            new_json=$(echo "$new_json" | jq --arg k "$key" 'del(.[$k])')
        done
        
        # 파라미터 타입 확인
        local param_type
        param_type=$(aws ssm get-parameter --name "$name" --query "Parameter.Type" --output text 2>/dev/null)
        
        if [[ "$param_type" == "SecureString" ]]; then
            aws ssm put-parameter --name "$name" --value "$new_json" --type SecureString --overwrite
        else
            aws ssm put-parameter --name "$name" --value "$new_json" --type String --overwrite
        fi
    else
        # 전체 삭제
        aws ssm delete-parameter --name "$name"
    fi
}

ssm_list() {
    local prefix="$1"
    
    # 파라미터 목록과 타입 정보를 함께 조회
    aws ssm describe-parameters \
        --parameter-filters "Key=Name,Option=BeginsWith,Values=$prefix" \
        --query "Parameters[*].[Name,Type]" \
        --output table | \
    sed 's/SecureString/SecureString/g'
}

# 직접 실행 시 사용법 출력
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    case "$1" in
        "get")
            ssm_get "$2"
            ;;
        "set")
            # set 명령어의 경우 옵션을 포함한 모든 인자를 전달
            ssm_set "${@:2}"
            ;;
        "del")
            ssm_del "${@:2}"
            ;;
        "list")
            ssm_list "$2"
            ;;
        *)
            echo "Usage: $0 {get|set|del|list} [parameter-name] [value|options] [options]"
            echo ""
            echo "Examples:"
            echo "  Get parameter:"
            echo "    $0 get /foo/bar"
            echo ""
            echo "  Set parameter (simple):"
            echo "    $0 set /foo/bar value"
            echo "    $0 set /foo/bar value -s"
            echo ""
            echo "  Set parameter (JSON mode):"
            echo "    $0 set /foo/bar -e foo=bar -e baz=qux"
            echo ""
            echo "  Delete parameter (complete):"
            echo "    $0 del /foo/bar"
            echo ""
            echo "  Delete parameter (partial - remove specific keys):"
            echo "    $0 del /foo/bar -e foo"
            echo "    $0 del /test/config -e user -e password"
            echo ""
            echo "  List parameters:"
            echo "    $0 list /foo"
            echo ""
            echo "Options:"
            echo "  -e, --entry     Add/update key=value pair (JSON mode)"
            echo "  -s, --secret    Store as SecureString (encrypted)"
            echo ""
            echo "Note: JSON mode automatically detects and parses JSON values."
            echo "      Non-JSON values are stored as strings."
            ;;
    esac
fi